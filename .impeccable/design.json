  "narrative": {
    "northStar": "The Console in a Dim Room",
    "overview": "The page is a handheld that boots in the dark. A black void, a giant serif \"Welcome.\", a cartridge the visitor inserts, and every later section is a scene the same machine is showing. Dark is fixed on purpose; there is no light theme. The tone is playful and exact: pixel type for anything the machine says, a serif for anything a person would read aloud, a plain grotesk for sentences.\n\nThe system is flat. Surfaces are separated by 1px rules and a one-step tonal lift, not by shadow, gradient or blur. One accent, acid lime, carries primary actions, focus, selection and the closing band. Amber and lavender exist only as tints on generated pixel creatures and the cover cards that borrow their tone. Identity comes from a deterministic mirrored pixel creature per entry and category, generated at runtime, so the page ships no image files.",
    "keyCharacteristics": [
      "Fixed dark theme: void ground, paper text, one lime accent.",
      "Three voices: Instrument Serif (display), Silkscreen (machine labels), Hanken Grotesk (reading).",
      "Flat surfaces, 1px rules, 4/6/8px radii.",
      "The console and cartridge are drawn in CSS; creatures are generated SVG.",
      "One authored motion: cartridge insert and boot sequence."
    ],
    "rules": [
      {
        "name": "The One Light Rule",
        "body": "Lime is the only accent that does interface work. Amber and lavender tint pixel art and the cover cards that inherit a creature's tone, nothing else.",
        "section": "colors"
      },
      {
        "name": "The Loud Band Rule",
        "body": "The lime-filled closing section is the single full-bleed loud moment. No other section takes an accent background.",
        "section": "colors"
      },
      {
        "name": "The Three Voices Rule",
        "body": "Serif speaks in headings and entry names, pixel face labels and reports, grotesk carries sentences. Do not swap roles.",
        "section": "typography"
      },
      {
        "name": "The Display Cap Rule",
        "body": "Serif display never exceeds 6rem.",
        "section": "typography"
      },
      {
        "name": "The Flat Page Rule",
        "body": "Outside the drawn console, nothing carries a shadow, gradient, glow or blur. Hover is translateY, border color or a raise fill.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the page dark, void ground with paper text, and use lime for primary actions, focus and selection only.",
      "Do give every entry and category its deterministic pixel creature from the generator, and tint it from the palette (lime, amber, lavender, paper).",
      "Do use Silkscreen for HUD, chips, buttons, counts and screen text; Hanken Grotesk for sentences; Instrument Serif for headings, never above 6rem.",
      "Do use 4px radius on controls, 6px on cards, 8px on the palette, 1px rules between surfaces.",
      "Do keep every target at 44px minimum and a 2px lime focus outline.",
      "Do make new motion a transform or color change under the shared ease, and disable it under reduced motion."
    ],
    "donts": [
      "Don't add gradient text, glass, glow or blur to any surface.",
      "Don't use amber or lavender as button, link or border colors on interface; they tint pixel art and cover cards.",
      "Don't add a second full-bleed accent section; the lime closing band is the one loud moment.",
      "Don't set sentences in Silkscreen or headings in the grotesk.",
      "Don't introduce a light theme or new greys without a reason; reuse void, raise, line and line-strong."
    ]
  }
}